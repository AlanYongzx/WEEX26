# Text files: normalize line endings
*.m      text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.csv    text eol=lf
*.txt    text eol=lf

# Binary files: never diff/merge as text
*.xlsx   binary
*.xls    binary
*.mat    binary
*.mlx    binary
*.slx    binary
*.pptx   binary
*.odp    binary
*.docx   binary
*.pdf    binary
*.png    binary
*.jpg    binary
*.svg    text eol=lf
